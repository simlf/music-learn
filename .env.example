# Copy this file to .env and fill in real values. .env is gitignored.

# Shared-secret bearer token (D-03). Generate one with: openssl rand -hex 32
API_TOKEN=

# Path to the SQLite file inside the api container. docker-compose.yml mounts
# ./data to /data, so this path persists across container restarts.
DB_PATH=/data/music-learn.db

# Port the api service listens on and is exposed on.
PORT=8080

# Interface the api service binds to inside the container.
HOST=0.0.0.0

# Origin allowed to call the api service, e.g. the SvelteKit dev server.
CORS_ORIGIN=http://localhost:5173

# Base URL the browser uses to reach the api service (client-side, VITE_ prefix required).
VITE_API_BASE_URL=http://localhost:8080
